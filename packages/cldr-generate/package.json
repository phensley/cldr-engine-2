{
  "name": "@phensley/cldr-generate",
  "version": "0.0.0",
  "type": "module",
  "description": "Generator (prototype): reads a consumer's cldr.config.ts + the runtime manifest, emits a literal, already-minimal cldr.gen.ts. Node-only CLI; runs at the consumer's build time.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cldr-generate": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "@phensley/cldr": "0.0.0"
  },
  "devDependencies": {
    "@phensley/cldr": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  }
}
