{
  "name": "@phensley/cldr",
  "version": "0.0.0",
  "type": "module",
  "description": "Runtime (prototype): reference implementation + generated-client runtime. Isomorphic, tree-shakable; pack assets inlined from the data pipeline's build output. Per-method subpaths are what the generated client imports; ./manifest is generator-only (node-gated).",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decimal/*": {
      "types": "./dist/decimal/*.d.ts",
      "default": "./dist/decimal/*.js"
    },
    "./currency/*": {
      "types": "./dist/currency/*.d.ts",
      "default": "./dist/currency/*.js"
    },
    "./packs/*": {
      "types": "./dist/packs/*.d.ts",
      "default": "./dist/packs/*.js"
    },
    "./manifest": {
      "node": {
        "types": "./dist/manifest.d.ts",
        "default": "./dist/manifest.js"
      }
    }
  },
  "devDependencies": {
    "@cldr/internal-core": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  }
}
