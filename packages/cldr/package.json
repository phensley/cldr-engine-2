{
  "name": "@phensley/cldr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime (prototype): reference implementation + generated-client runtime. Isomorphic, tree-shakable; pack assets inlined from the data pipeline's build output. S2 selection-mechanism subject.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./decimal/*": {
      "types": "./src/decimal/*.ts",
      "default": "./src/decimal/*.ts"
    },
    "./currency/*": {
      "types": "./src/currency/*.ts",
      "default": "./src/currency/*.ts"
    },
    "./packs/*": {
      "types": "./src/packs/*.ts",
      "default": "./src/packs/*.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    }
  },
  "dependencies": {
    "@cldr/internal-core": "workspace:*"
  },
  "sideEffects": false
}
