{
  "name": "@phensley/cldr",
  "version": "0.0.0",
  "type": "module",
  "description": "Runtime (prototype): reference implementation + generated-client runtime. Isomorphic, tree-shakable; pack assets inlined from the data pipeline's build output. Per-method subpaths are what the generated client imports; ./manifest is generator-only (node-gated).",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./decimal/compare": {
      "types": "./dist/decimal/compare.d.ts",
      "default": "./dist/decimal/compare.js"
    },
    "./decimal/min": {
      "types": "./dist/decimal/min.d.ts",
      "default": "./dist/decimal/min.js"
    },
    "./decimal/max": {
      "types": "./dist/decimal/max.d.ts",
      "default": "./dist/decimal/max.js"
    },
    "./decimal/move-point": {
      "types": "./dist/decimal/move-point.d.ts",
      "default": "./dist/decimal/move-point.js"
    },
    "./decimal/format/scientific": {
      "types": "./dist/decimal/format/scientific.d.ts",
      "default": "./dist/decimal/format/scientific.js"
    },
    "./currency/format": {
      "types": "./dist/currency/format.d.ts",
      "default": "./dist/currency/format.js"
    },
    "./currency/symbol": {
      "types": "./dist/currency/symbol.d.ts",
      "default": "./dist/currency/symbol.js"
    },
    "./currency/fraction-digits": {
      "types": "./dist/currency/fraction-digits.d.ts",
      "default": "./dist/currency/fraction-digits.js"
    },
    "./calendar/format": {
      "types": "./dist/calendar/format.d.ts",
      "default": "./dist/calendar/format.js"
    },
    "./calendar/month-name": {
      "types": "./dist/calendar/month-name.d.ts",
      "default": "./dist/calendar/month-name.js"
    },
    "./calendar/weekday-name": {
      "types": "./dist/calendar/weekday-name.d.ts",
      "default": "./dist/calendar/weekday-name.js"
    },
    "./calendar/first-day": {
      "types": "./dist/calendar/first-day.d.ts",
      "default": "./dist/calendar/first-day.js"
    },
    "./calendar/offset": {
      "types": "./dist/calendar/offset.d.ts",
      "default": "./dist/calendar/offset.js"
    },
    "./plural/select": {
      "types": "./dist/plural/select.d.ts",
      "default": "./dist/plural/select.js"
    },
    "./packs/*": {
      "types": "./dist/packs/*.d.ts",
      "default": "./dist/packs/*.js"
    },
    "./manifest": {
      "node": {
        "types": "./dist/manifest.d.ts",
        "default": "./dist/manifest.js"
      }
    }
  },
  "devDependencies": {
    "@cldr/internal-core": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  }
}
