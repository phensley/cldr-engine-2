{
  "name": "cldr-engine-2",
  "private": true,
  "type": "module",
  "description": "Cleanroom prototype: cldr-engine 2.0 (minimal footprint, modular, granular)",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:packs": "tsx scripts/generate-packs.ts",
    "generate:client": "node packages/cldr-generate/bin/cldr-generate.mjs --config examples/eager-app/cldr.config.ts --out examples/eager-app/src/cldr.gen.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "bundle-proof": "tsx scripts/bundle-proof.ts",
    "build": "tsx scripts/build.ts",
    "packaging-check": "pnpm build && pnpm depcruise && tsx scripts/check-packages.ts",
    "depcruise": "depcruise packages internal --config .dependency-cruiser.cjs",
    "pretest": "pnpm build",
    "publish-roundtrip": "tsx scripts/publish-roundtrip.ts",
    "benchmark:pools": "tsx scripts/benchmark-pools.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@phensley/cldr": "workspace:*",
    "@phensley/cldr-generate": "workspace:*",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "publint": "^0.3.24",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "verdaccio": "^6.10.1",
    "vitest": "^3.0.0"
  }
}
