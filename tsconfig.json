{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "esnext",
      "dom"
    ],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "internal",
    "packages",
    "examples"
  ],
  "exclude": [
    "**/dist",
    "**/.bundle-proof"
  ]
}
